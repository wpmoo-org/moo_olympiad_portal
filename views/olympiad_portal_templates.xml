<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- Portal Home — Role detection + counters                      -->
        <!-- ============================================================ -->
        <template id="olympiad_home" name="Olympiad Portal Home">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h1 class="mb-4">Olympiad Portal</h1>

                    <div class="row g-4">
                        <!-- Mentor Card -->
                        <div class="col-md-6" t-if="is_mentor">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="fa fa-user-tie me-2"></i>Mentor Dashboard
                                    </h5>
                                    <p class="card-text text-muted">Manage your projects and students.</p>
                                    <div class="d-flex justify-content-between mt-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold" t-esc="mentor_project_count"/>
                                            <small class="text-muted">Projects</small>
                                        </div>
                                        <div class="text-center">
                                            <div class="display-6 fw-bold" t-esc="mentor_student_count"/>
                                            <small class="text-muted">Students</small>
                                        </div>
                                    </div>
                                    <a href="/my/olympiad/mentor" class="btn btn-primary mt-3 w-100">Go to Mentor Dashboard</a>
                                </div>
                            </div>
                        </div>

                        <!-- Jury Card -->
                        <div class="col-md-6" t-if="is_jury">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="fa fa-gavel me-2"></i>Jury Dashboard
                                    </h5>
                                    <p class="card-text text-muted">Review and score assigned projects.</p>
                                    <div class="d-flex justify-content-between mt-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold" t-esc="jury_assignment_count"/>
                                            <small class="text-muted">Assignments</small>
                                        </div>
                                        <div class="text-center">
                                            <div class="display-6 fw-bold" t-esc="jury_scored_count"/>
                                            <small class="text-muted">Scored</small>
                                        </div>
                                    </div>
                                    <a href="/my/olympiad/jury" class="btn btn-secondary mt-3 w-100">Go to Jury Dashboard</a>
                                </div>
                            </div>
                        </div>

                        <!-- No Role Warning -->
                        <div class="col-12" t-if="not is_mentor and not is_jury">
                            <div class="alert alert-info">
                                <strong>Welcome!</strong> You are currently not assigned as a mentor or jury member. Please contact the administrator if you believe this is an error.
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- ============================================================ -->
        <!-- Mentor Dashboard — Project list                               -->
        <!-- ============================================================ -->
        <template id="mentor_dashboard" name="Mentor Dashboard">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1>Mentor Dashboard</h1>
                        <a href="/my/olympiad" class="btn btn-outline-secondary">Back to Portal</a>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <div class="display-5 fw-bold" t-esc="project_count"/>
                                    <small class="text-muted">Total Projects</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <div class="display-5 fw-bold" t-esc="student_count"/>
                                    <small class="text-muted">Total Students</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3 class="mb-3">My Projects</h3>
                    <div t-if="not projects" class="alert alert-info">
                        You have no projects yet.
                    </div>
                    <div t-if="projects" class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Event</th>
                                    <th>Category</th>
                                    <th>Students</th>
                                    <th>State</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="projects" t-as="project">
                                    <td t-esc="project.code"/>
                                    <td t-esc="project.name"/>
                                    <td t-esc="project.event_id.name"/>
                                    <td t-esc="project.category_id.name"/>
                                    <td t-esc="project.num_students"/>
                                    <td>
                                        <span t-if="project.state == 'draft'" class="badge bg-secondary">Draft</span>
                                        <span t-if="project.state == 'published'" class="badge bg-success">Published</span>
                                        <span t-if="project.state == 'finished'" class="badge bg-primary">Finished</span>
                                        <span t-if="project.state == 'cancelled'" class="badge bg-danger">Cancelled</span>
                                    </td>
                                    <td>
                                        <a t-att-href="'/my/olympiad/project/' + str(project.id)" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <!-- Mentor: Project Detail -->
        <template id="mentor_project_detail" name="Mentor Project Detail">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 t-esc="project.name"/>
                        <a href="/my/olympiad/mentor" class="btn btn-outline-secondary">Back to Projects</a>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">Project Info</div>
                                <div class="card-body">
                                    <p><strong>Code:</strong> <span t-esc="project.code"/></p>
                                    <p><strong>Event:</strong> <span t-esc="project.event_id.name"/></p>
                                    <p><strong>Category:</strong> <span t-esc="project.category_id.name"/></p>
                                    <p><strong>Presentation:</strong> <span t-esc="project.pres_lang"/></p>
                                    <p><strong>State:</strong> <span t-esc="project.state"/></p>
                                    <p><strong>Score:</strong> <span t-esc="project.project_score"/></p>
                                    <p><strong>Medal:</strong> <span t-esc="project.medal"/></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">Students</div>
                                <div class="card-body">
                                    <div t-if="not students" class="text-muted">No students assigned.</div>
                                    <ul t-if="students" class="list-group list-group-flush">
                                        <li t-foreach="students" t-as="stu" class="list-group-item">
                                            <span t-esc="stu.student_id.name"/>
                                            <span t-if="stu.role == 'leader'" class="badge bg-info ms-2">Leader</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- ============================================================ -->
        <!-- Jury Dashboard — Assignment list                              -->
        <!-- ============================================================ -->
        <template id="jury_dashboard" name="Jury Dashboard">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1>Jury Dashboard</h1>
                        <a href="/my/olympiad" class="btn btn-outline-secondary">Back to Portal</a>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <div class="display-5 fw-bold" t-esc="assignment_count"/>
                                    <small class="text-muted">Total Assignments</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <div class="display-5 fw-bold" t-esc="scored_count"/>
                                    <small class="text-muted">Scored</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3 class="mb-3">My Assignments</h3>
                    <div t-if="not assignments" class="alert alert-info">
                        You have no assignments yet.
                    </div>
                    <div t-if="assignments" class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Project</th>
                                    <th>Event</th>
                                    <th>Category</th>
                                    <th>Assigned Date</th>
                                    <th>Score</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="assignments" t-as="assignment">
                                    <td t-esc="assignment.project_id.name"/>
                                    <td t-esc="assignment.project_id.event_id.name"/>
                                    <td t-esc="assignment.project_id.category_id.name"/>
                                    <td t-esc="assignment.assigned_date"/>
                                    <td>
                                        <span t-if="assignment.score > 0" t-esc="assignment.score"/>
                                        <span t-else="1" class="badge bg-warning">Pending</span>
                                    </td>
                                    <td>
                                        <a t-att-href="'/my/olympiad/assignment/' + str(assignment.id)" class="btn btn-sm btn-outline-primary">Score</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <!-- Jury: Assignment Detail + Score Form -->
        <template id="jury_assignment_detail" name="Jury Assignment Detail">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 t-esc="project.name"/>
                        <a href="/my/olympiad/jury" class="btn btn-outline-secondary">Back to Assignments</a>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">Project Information</div>
                                <div class="card-body">
                                    <p><strong>Code:</strong> <span t-esc="project.code"/></p>
                                    <p><strong>Event:</strong> <span t-esc="project.event_id.name"/></p>
                                    <p><strong>Category:</strong> <span t-esc="project.category_id.name"/></p>
                                    <p><strong>Mentor:</strong> <span t-esc="project.mentor_id.name"/></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                <div class="card-header">Your Score</div>
                <div class="card-body">
                    <div t-if="score_error" class="alert alert-danger">
                        <strong>Invalid score.</strong>
                        <span t-if="error_msg" t-esc="error_msg"/>
                        <span t-else="">Please enter a number between 0 and 100.</span>
                    </div>
                                    <form t-att-action="'/my/olympiad/assignment/' + str(assignment.id) + '/score'" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label">Score (0-100)</label>
                                            <input type="number" name="score" class="form-control" min="0" max="100" step="0.1" t-att-value="assignment.score if assignment.score > 0 else ''" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Comments</label>
                                            <textarea name="comments" class="form-control" rows="3"><t t-esc="assignment.comments or ''"/></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Submit Score</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
        <!-- ============================================================ -->
        <!-- Public Pages                                                   -->
        <!-- ============================================================ -->

        <!-- Public: Events List -->
        <template id="public_events" name="Public Events">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <h1 class="mb-4">Olympiad Events</h1>
                    <div t-if="not events" class="alert alert-info">
                        No active events at the moment. Please check back later!
                    </div>
                    <div t-if="events" class="row g-4">
                        <div t-foreach="events" t-as="event" class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title" t-esc="event.name"/>
                                    <p class="card-text">
                                        <span class="badge bg-primary" t-esc="event.state"/>
                                    </p>
                                    <p class="card-text">
                                        <strong>Start:</strong> <span t-esc="event.dates"/><br/>
                                        <strong>End:</strong> <span t-esc="event.date_end"/>
                                    </p>
                                    <p class="card-text" t-if="event.category_ids">
                                        <strong>Categories:</strong> <span t-esc="', '.join(event.category_ids.mapped('name'))"/>
                                    </p>
                                    <a t-att-href="'/olympiad/event/' + str(event.id)" class="btn btn-outline-primary">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Public: Event Detail -->
        <template id="public_event_detail" name="Public Event Detail">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-lg-8">
                            <h1 t-esc="event.name"/>
                            <div class="mb-3">
                                <span class="badge bg-primary me-2" t-esc="event.state"/>
                                <span class="text-muted">Registration Fee: <span t-esc="event.currency_id.symbol + ' ' + str(event.registration_fee)"/></span>
                            </div>
                            <hr/>
                            <div class="row mb-4">
                                <div class="col-sm-6">
                                    <p><strong>Start Date:</strong> <span t-esc="event.dates"/></p>
                                    <p><strong>End Date:</strong> <span t-esc="event.date_end"/></p>
                                </div>
                                <div class="col-sm-6">
                                    <p><strong>Gold Min:</strong> <span t-esc="event.medal_gold_min"/></p>
                                    <p><strong>Silver Min:</strong> <span t-esc="event.medal_silver_min"/></p>
                                    <p><strong>Bronze Min:</strong> <span t-esc="event.medal_bronze_min"/></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Categories</h5>
                                    <ul t-if="categories" class="list-group list-group-flush">
                                        <li t-foreach="categories" t-as="cat" class="list-group-item">
                                            <a t-att-href="'/olympiad/category/' + str(cat.id)" t-esc="cat.name"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Public: Categories List -->
        <template id="public_categories" name="Public Categories">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <h1 class="mb-4">Olympiad Categories</h1>
                    <div t-if="not categories" class="alert alert-info">
                        No categories available at the moment.
                    </div>
                    <div t-if="categories" class="row g-4">
                        <div t-foreach="categories" t-as="category" class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body text-center">
                                    <h5 class="card-title" t-esc="category.name"/>
                                    <p class="card-text">
                                        <span class="badge bg-info" t-esc="'Max ' + str(category.max_participants) + ' participants'"/>
                                    </p>
                                    <a t-att-href="'/olympiad/category/' + str(category.id)" class="btn btn-outline-primary">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Public: Category Detail -->
        <template id="public_category_detail" name="Public Category Detail">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <h1 t-esc="category.name"/>
                            <div class="card">
                                <div class="card-body">
                                    <p><strong>Code:</strong> <span t-esc="category.code"/></p>
                                    <p><strong>Max Participants:</strong> <span t-esc="category.max_participants"/></p>
                                    <hr/>
                                    <div t-if="category.description">
                                        <h5>Description</h5>
                                        <div t-out="category.description"/>
                                    </div>
                                    <div t-if="category.criteria">
                                        <h5 class="mt-3">Judging Criteria</h5>
                                        <div t-out="category.criteria"/>
                                    </div>
                                </div>
                            </div>
                            <a href="/olympiad/categories" class="btn btn-outline-secondary mt-3">Back to All Categories</a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- ============================================================ -->
        <!-- Mentor/Jury Application Forms                                  -->
        <!-- ============================================================ -->

        <!-- Apply: Mentor -->
        <template id="apply_mentor" name="Apply as Mentor">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-md-8 offset-md-2">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h3 class="mb-0">Apply as Mentor</h3>
                                </div>
                                <div class="card-body">
                                    <form action="/olympiad/apply/mentor/submit" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label">Name</label>
                                            <input type="text" class="form-control" t-att-value="partner.name" disabled="disabled"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" t-att-value="partner.email" disabled="disabled"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Tell us about yourself</label>
                                            <textarea name="bio" class="form-control" rows="4" placeholder="Brief bio / experience..." required="required"/>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Submit Application</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Apply: Jury -->
        <template id="apply_jury" name="Apply as Jury">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-md-8 offset-md-2">
                            <div class="card">
                                <div class="card-header bg-secondary text-white">
                                    <h3 class="mb-0">Apply as Jury Member</h3>
                                </div>
                                <div class="card-body">
                                    <form action="/olympiad/apply/jury/submit" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label">Name</label>
                                            <input type="text" class="form-control" t-att-value="partner.name" disabled="disabled"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" t-att-value="partner.email" disabled="disabled"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Tell us about your expertise</label>
                                            <textarea name="expertise" class="form-control" rows="4" placeholder="Relevant experience, degrees, etc." required="required"/>
                                        </div>
                                        <button type="submit" class="btn btn-secondary">Submit Application</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Apply: Jury Success -->
        <template id="apply_jury_success" name="Jury Application Success">
            <t t-call="website.layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-md-8 offset-md-2">
                            <div class="alert alert-success">
                                <h4>Application Submitted Successfully!</h4>
                                <p>Thank you, <strong t-esc="partner.name"/>, for applying as a jury member.</p>
                                <p>Your application is pending admin approval. You will be notified once approved.</p>
                                <a href="/my/olympiad" class="btn btn-primary mt-3">Go to Portal</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

 <!-- ============================================================ -->
 <!-- Project Registration Wizard -->
 <!-- ============================================================ -->

 <!-- Step 1: Project Details -->
 <template id="register_project" name="Register Project - Step 1">
 <t t-call="website.layout">
 <style>
 .nav-pills .nav-link.completed { background-color: #198754; color: #fff; }
 .nav-pills .nav-link.active { background-color: #0d6efd; color: #fff; }
 .nav-pills .nav-link.disabled { color: #6c757d; }
 </style>
 <div class="container mt-4">
 <div class="row">
 <div class="col-md-8 offset-md-2">
 <div class="card">
 <div class="card-header bg-primary text-white">
 <h3 class="mb-0">Step 1/5: Project Details</h3>
 </div>
 <div class="card-body">
 <ul class="nav nav-pills mb-4">
 <li class="nav-item"><span class="nav-link active">1. Project</span></li>
 <li class="nav-item"><span class="nav-link disabled">2. Students</span></li>
 <li class="nav-item"><span class="nav-link disabled">3. Accommodation</span></li>
 <li class="nav-item"><span class="nav-link disabled">4. Excursion</span></li>
 <li class="nav-item"><span class="nav-link disabled">5. Summary</span></li>
 </ul>
 <form action="/olympiad/register/project/submit" method="post">
 <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
 <div class="mb-3">
 <label class="form-label">Project Name</label>
 <input type="text" name="name" class="form-control" required="required" placeholder="Enter project name..."/>
 </div>
 <div class="mb-3">
 <label class="form-label">Select Event</label>
 <select name="event_id" class="form-select" required="required" id="event_select">
 <option value="">-- Select an event --</option>
 <t t-foreach="events" t-as="event">
 <option t-att-value="event.id" t-esc="event.name"/>
 </t>
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Select Category</label>
 <select name="category_id" class="form-select" required="required" id="category_select">
 <option value="">-- Select a category --</option>
 <t t-foreach="events" t-as="event">
 <optgroup t-att-label="event.name" t-att-data-event="event.id">
 <option t-foreach="event.category_ids" t-as="cat" t-att-value="cat.id" t-esc="cat.name"/>
 </optgroup>
 </t>
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Presentation Language</label>
 <select name="pres_lang" class="form-select">
 <option value="en">English</option>
 <option value="de">German</option>
 </select>
 </div>
 <div class="d-flex justify-content-between">
 <a href="/my/olympiad/mentor" class="btn btn-outline-secondary">Cancel</a>
 <button type="submit" class="btn btn-primary">Next: Add Students</button>
 </div>
 </form>
 </div>
 </div>
 </div>
 </div>
 </div>
 </t>
 </template>

 <!-- Step 2: Add Students -->
 <template id="register_students" name="Register Project - Step 2">
 <t t-call="website.layout">
 <div class="container mt-4">
 <div class="row">
 <div class="col-md-10 offset-md-1">
 <div class="card">
 <div class="card-header bg-primary text-white">
 <h3 class="mb-0">Step 2/5: Add Students</h3>
 </div>
 <div class="card-body">
 <ul class="nav nav-pills mb-4">
 <li class="nav-item"><span class="nav-link completed">1. Project</span></li>
 <li class="nav-item"><span class="nav-link active">2. Students</span></li>
 <li class="nav-item"><span class="nav-link disabled">3. Accommodation</span></li>
 <li class="nav-item"><span class="nav-link disabled">4. Excursion</span></li>
 <li class="nav-item"><span class="nav-link disabled">5. Summary</span></li>
 </ul>

 <div t-if="student_error" class="alert alert-danger">
 At least one student is required to continue.
 </div>

 <p class="text-muted mb-3">
 Project: <strong t-esc="project.name"/> |
 Category: <strong t-esc="project.category_id.name"/> |
 Max participants: <strong t-esc="project.category_id.max_participants"/>
 </p>

 <form t-att-action="'/olympiad/register/' + str(project.id) + '/students/submit'" method="post">
 <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
 <input type="hidden" name="student_count" id="student_count" value="0"/>

 <div id="students_container"></div>

 <button type="button" class="btn btn-outline-primary mb-3" id="add_student_btn">
 <i class="fa fa-plus me-1"></i>Add Student
 </button>

 <div class="d-flex justify-content-between">
 <a t-att-href="'/olympiad/register/project'" class="btn btn-outline-secondary">Back</a>
 <button type="submit" class="btn btn-primary">Next: Accommodation</button>
 </div>
 </form>

 <template id="student_form_template">
 <div class="card mb-3 border-primary student-card">
 <div class="card-header d-flex justify-content-between align-items-center">
 <span class="student-label">Student 1</span>
 <button type="button" class="btn btn-sm btn-outline-danger remove-student-btn" title="Remove">X</button>
 </div>
 <div class="card-body">
 <div class="row g-3">
 <div class="col-md-4">
 <label class="form-label">First Name *</label>
 <input type="text" class="form-control student-first-name" required="required"/>
 </div>
 <div class="col-md-4">
 <label class="form-label">Last Name *</label>
 <input type="text" class="form-control student-last-name" required="required"/>
 </div>
 <div class="col-md-4">
 <label class="form-label">Birth Date *</label>
 <input type="date" class="form-control student-birth-date" required="required"/>
 </div>
 <div class="col-md-3">
 <label class="form-label">Gender *</label>
 <select class="form-select student-gender" required="required">
 <option value="">--</option>
 <option value="M">Male</option>
 <option value="F">Female</option>
 <option value="D">Diverse</option>
 </select>
 </div>
 <div class="col-md-3">
 <label class="form-label">Country *</label>
 <select class="form-select student-country" required="required">
 <option value="">--</option>
 <t t-foreach="countries" t-as="country">
 <option t-att-value="country.id" t-esc="country.name"/>
 </t>
 </select>
 </div>
 <div class="col-md-3">
 <label class="form-label">T-Shirt Size *</label>
 <select class="form-select student-tshirt" required="required">
 <option value="">--</option>
 <option value="XS">Extra Small</option>
 <option value="S">Small</option>
 <option value="M">Medium</option>
 <option value="L">Large</option>
 <option value="XL">Extra Large</option>
 <option value="XXL">Double Extra Large</option>
 </select>
 </div>
 <div class="col-md-3">
 <label class="form-label">Email</label>
 <input type="email" class="form-control student-email"/>
 </div>
 </div>
 </div>
 </div>
 </template>

 <script type="text/javascript">
 document.addEventListener('DOMContentLoaded', function() {
 var container = document.getElementById('students_container');
 var countInput = document.getElementById('student_count');
 var addBtn = document.getElementById('add_student_btn');
 var maxStudents = <t t-esc="project.category_id.max_participants"/>;

 function updateLabels() {
 var cards = container.querySelectorAll('.student-card');
 countInput.value = cards.length;
 cards.forEach(function(card, idx) {
 card.querySelector('.student-label').textContent = 'Student ' + (idx + 1) + (idx === 0 ? ' (Leader)' : '');
 var inputs = card.querySelectorAll('input, select');
 inputs.forEach(function(inp) {
 var nameAttr = inp.className;
 if (nameAttr.includes('student-first-name')) inp.name = 'student_' + idx + '_first_name';
 else if (nameAttr.includes('student-last-name')) inp.name = 'student_' + idx + '_last_name';
 else if (nameAttr.includes('student-birth-date')) inp.name = 'student_' + idx + '_birth_date';
 else if (nameAttr.includes('student-gender')) inp.name = 'student_' + idx + '_gender';
 else if (nameAttr.includes('student-country')) inp.name = 'student_' + idx + '_country_id';
 else if (nameAttr.includes('student-tshirt')) inp.name = 'student_' + idx + '_tshirt_size';
 else if (nameAttr.includes('student-email')) inp.name = 'student_' + idx + '_email';
 else if (nameAttr.includes('student-phone')) inp.name = 'student_' + idx + '_phone';
 });
 });
 }

 function addStudentCard() {
 var cards = container.querySelectorAll('.student-card');
 if (cards.length >= maxStudents) return;
 var template = document.getElementById('student_form_template');
 var clone = template.content.cloneNode(true);
 container.appendChild(clone);
 updateLabels();
 }

 container.addEventListener('click', function(e) {
 if (e.target.classList.contains('remove-student-btn')) {
 e.target.closest('.student-card').remove();
 updateLabels();
 }
 });

 addBtn.addEventListener('click', addStudentCard);
 addStudentCard();
 });
 </script>
 </div>
 </div>
 </div>
 </div>
 </div>
 </t>
 </template>

 <!-- Step 3: Accommodation -->
 <template id="register_accommodation" name="Register Project - Step 3">
 <t t-call="website.layout">
 <div class="container mt-4">
 <div class="row">
 <div class="col-md-8 offset-md-2">
 <div class="card">
 <div class="card-header bg-primary text-white">
 <h3 class="mb-0">Step 3/5: Accommodation</h3>
 </div>
 <div class="card-body">
 <ul class="nav nav-pills mb-4">
 <li class="nav-item"><span class="nav-link completed">1. Project</span></li>
 <li class="nav-item"><span class="nav-link completed">2. Students</span></li>
 <li class="nav-item"><span class="nav-link active">3. Accommodation</span></li>
 <li class="nav-item"><span class="nav-link disabled">4. Excursion</span></li>
 <li class="nav-item"><span class="nav-link disabled">5. Summary</span></li>
 </ul>

 <p class="text-muted mb-3">
 Accommodation fee: <strong t-esc="project.event_id.currency_id.symbol"/> <t t-esc="project.event_id.accommodation_fee"/> per night
 </p>

 <form t-att-action="'/olympiad/register/' + str(project.id) + '/accommodation/submit'" method="post">
 <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

 <div t-if="not accommodations" class="alert alert-info">
 No accommodation dates configured for this event. You can skip this step.
 </div>

 <div t-foreach="project.student_ids" t-as="line" class="card mb-3">
 <div class="card-header">
 <strong t-esc="line.student_id.name"/>
 <span t-if="line.role == 'leader'" class="badge bg-info ms-2">Leader</span>
 </div>
 <div class="card-body">
 <div class="form-check mb-3">
 <input type="checkbox" class="form-check-input"
 t-att-id="'no_accommodation_' + str(line.id)"
 t-att-name="'no_accommodation_' + str(line.id)"
 t-att-checked="line.no_accommodation"/>
 <label class="form-check-label" t-att-for="'no_accommodation_' + str(line.id)">No accommodation needed</label>
 </div>
 <div t-if="accommodations" class="accommodation-dates">
 <t t-foreach="accommodations" t-as="acc">
 <div class="form-check">
 <input type="checkbox" class="form-check-input acc-checkbox"
 t-att-id="f'acc_{line.id}_{acc.id}'"
 t-att-data-line="str(line.id)"
 t-att-data-acc="str(acc.id)"
 t-att-checked="acc in line.accommodation_ids"/>
 <label class="form-check-label" t-att-for="f'acc_{line.id}_{acc.id}'">
 <span t-esc="acc.date"/> — <span t-esc="acc.label or 'No label'"/>
 </label>
 </div>
 </t>
 <input type="hidden" t-att-name="'accommodation_' + str(line.id)" class="acc-hidden" t-att-data-line="str(line.id)"/>
 </div>
 </div>
 </div>

 <div class="d-flex justify-content-between">
 <a t-att-href="'/olympiad/register/' + str(project.id) + '/students'" class="btn btn-outline-secondary">Back</a>
 <button type="submit" class="btn btn-primary">Next: Excursion</button>
 </div>
 </form>

 <script type="text/javascript">
 document.addEventListener('DOMContentLoaded', function() {
 document.querySelectorAll('.form-check-input[id^="no_accommodation_"]').forEach(function(cb) {
 cb.addEventListener('change', function() {
 var lineId = this.id.replace('no_accommodation_', '');
 var datesDiv = this.closest('.card-body').querySelector('.accommodation-dates');
 if (datesDiv) datesDiv.style.display = this.checked ? 'none' : 'block';
 if (this.checked) {
 document.querySelectorAll('.acc-checkbox[data-line="' + lineId + '"]').forEach(function(acc) {
 acc.checked = false;
 });
 }
 });
 document.dispatchEvent(new Event('updateAccHidden'));
 });

 document.addEventListener('change', function(e) {
 if (e.target.classList.contains('acc-checkbox')) {
 document.dispatchEvent(new Event('updateAccHidden'));
 }
 });

 document.addEventListener('updateAccHidden', function() {
 var lineIds = [];
 document.querySelectorAll('.acc-checkbox').forEach(function(cb) {
 if (cb.dataset.line &amp;&amp; lineIds.indexOf(cb.dataset.line) === -1) lineIds.push(cb.dataset.line);
 });
 lineIds.forEach(function(lineId) {
 var hidden = document.querySelector('.acc-hidden[data-line="' + lineId + '"]');
 if (!hidden) return;
 var selected = [];
 document.querySelectorAll('.acc-checkbox[data-line="' + lineId + '"]:checked').forEach(function(cb) {
 selected.push(cb.dataset.acc);
 });
 hidden.value = selected.join(',');
 });
 });
 });
 </script>
 </div>
 </div>
 </div>
 </div>
 </div>
 </t>
 </template>

 <!-- Step 4: Excursion -->
 <template id="register_excursion" name="Register Project - Step 4">
 <t t-call="website.layout">
 <div class="container mt-4">
 <div class="row">
 <div class="col-md-8 offset-md-2">
 <div class="card">
 <div class="card-header bg-primary text-white">
 <h3 class="mb-0">Step 4/5: Excursion</h3>
 </div>
 <div class="card-body">
 <ul class="nav nav-pills mb-4">
 <li class="nav-item"><span class="nav-link completed">1. Project</span></li>
 <li class="nav-item"><span class="nav-link completed">2. Students</span></li>
 <li class="nav-item"><span class="nav-link completed">3. Accommodation</span></li>
 <li class="nav-item"><span class="nav-link active">4. Excursion</span></li>
 <li class="nav-item"><span class="nav-link disabled">5. Summary</span></li>
 </ul>

 <p class="text-muted mb-3">
 Excursion fee: <strong t-esc="project.event_id.currency_id.symbol"/> <t t-esc="project.event_id.excursion_fee"/> per person
 </p>

 <form t-att-action="'/olympiad/register/' + str(project.id) + '/excursion/submit'" method="post">
 <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

 <div class="card mb-3">
 <div class="card-header">Mentor (You)</div>
 <div class="card-body">
 <div class="form-check">
 <input type="checkbox" class="form-check-input" name="mentor_excursion" id="mentor_excursion" t-att-checked="project.mentor_excursion"/>
 <label class="form-check-label" for="mentor_excursion">I want to join the excursion</label>
 </div>
 </div>
 </div>

 <div t-foreach="project.student_ids" t-as="line" class="card mb-3">
 <div class="card-header d-flex justify-content-between">
 <span><strong t-esc="line.student_id.name"/></span>
 <span t-if="line.role == 'leader'" class="badge bg-info">Leader</span>
 </div>
 <div class="card-body">
 <div class="form-check">
 <input type="checkbox" class="form-check-input"
 t-att-id="'excursion_' + str(line.id)"
 t-att-name="'excursion_' + str(line.id)"
 t-att-checked="line.excursion"/>
 <label class="form-check-label" t-att-for="'excursion_' + str(line.id)">Excursion</label>
 </div>
 </div>
 </div>

 <div class="d-flex justify-content-between">
 <a t-att-href="'/olympiad/register/' + str(project.id) + '/accommodation'" class="btn btn-outline-secondary">Back</a>
 <button type="submit" class="btn btn-primary">Next: Summary</button>
 </div>
 </form>
 </div>
 </div>
 </div>
 </div>
 </div>
 </t>
 </template>

 <!-- Step 5: Summary / Payment -->
 <template id="register_summary" name="Register Project - Step 5">
 <t t-call="website.layout">
 <div class="container mt-4">
 <div class="row">
 <div class="col-md-8 offset-md-2">
 <div class="card">
 <div class="card-header bg-primary text-white">
 <h3 class="mb-0">Step 5/5: Summary &amp; Payment</h3>
 </div>
 <div class="card-body">
 <ul class="nav nav-pills mb-4">
 <li class="nav-item"><span class="nav-link completed">1. Project</span></li>
 <li class="nav-item"><span class="nav-link completed">2. Students</span></li>
 <li class="nav-item"><span class="nav-link completed">3. Accommodation</span></li>
 <li class="nav-item"><span class="nav-link completed">4. Excursion</span></li>
 <li class="nav-item"><span class="nav-link active">5. Summary</span></li>
 </ul>

 <h5>Project Details</h5>
 <table class="table table-bordered mb-4">
 <tr><th>Project Name</th><td t-esc="project.name"/></tr>
 <tr><th>Event</th><td t-esc="project.event_id.name"/></tr>
 <tr><th>Category</th><td t-esc="project.category_id.name"/></tr>
 <tr><th>Presentation Language</th><td t-esc="project.pres_lang"/></tr>
 </table>

 <h5>Students (<t t-esc="project.num_students"/>)</h5>
 <table class="table table-bordered mb-4">
 <thead><tr><th>Name</th><th>Role</th><th>Accommodation Nights</th><th>Excursion</th></tr></thead>
 <tbody>
 <tr t-foreach="project.student_ids" t-as="line">
 <td t-esc="line.student_id.name"/>
 <td><span t-if="line.role == 'leader'" class="badge bg-info">Leader</span><span t-else="" class="badge bg-secondary">Member</span></td>
 <td t-esc="line.accommodation_nights"/>
 <td><span t-if="line.excursion">Yes</span><span t-else="">No</span></td>
 </tr>
 </tbody>
 </table>

 <h5>Cost Breakdown</h5>
 <table class="table table-bordered mb-4">
 <thead><tr><th>Item</th><th class="text-end">Amount</th></tr></thead>
 <tbody>
 <tr><td>Registration (<t t-esc="project.num_students"/> x <t t-esc="project.event_id.currency_id.symbol"/><t t-esc="project.event_id.registration_fee"/>)</td><td class="text-end"><t t-esc="project.event_id.currency_id.symbol"/> <t t-esc="registration_total"/></td></tr>
 <tr t-if="accommodation_total > 0"><td>Accommodation</td><td class="text-end"><t t-esc="project.event_id.currency_id.symbol"/> <t t-esc="accommodation_total"/></td></tr>
 <tr t-if="student_excursion_total > 0"><td>Student Excursions</td><td class="text-end"><t t-esc="project.event_id.currency_id.symbol"/> <t t-esc="student_excursion_total"/></td></tr>
 <tr t-if="mentor_excursion_total > 0"><td>Mentor Excursion</td><td class="text-end"><t t-esc="project.event_id.currency_id.symbol"/> <t t-esc="mentor_excursion_total"/></td></tr>
 <tr class="table-active fw-bold"><td>Grand Total</td><td class="text-end"><t t-esc="project.event_id.currency_id.symbol"/> <t t-esc="grand_total"/></td></tr>
 </tbody>
 </table>

 <div class="alert alert-info mb-4">
 <i class="fa fa-info-circle me-2"></i>Payment integration will be available soon. For now, your project will be submitted for review.
 </div>

 <form t-att-action="'/olympiad/register/' + str(project.id) + '/confirm'" method="post">
 <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
 <div class="d-flex justify-content-between">
 <a t-att-href="'/olympiad/register/' + str(project.id) + '/excursion'" class="btn btn-outline-secondary">Back</a>
 <button type="submit" class="btn btn-success btn-lg">Confirm &amp; Submit Project</button>
 </div>
 </form>
 </div>
 </div>
 </div>
 </div>
 </div>
 </t>
 </template>
