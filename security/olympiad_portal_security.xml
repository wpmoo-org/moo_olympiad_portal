<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

    <!-- Portal users can only see their own projects (mentor) -->
    <record id="rule_moo_olympiad_project_mentor_own" model="ir.rule">
        <field name="name">Project: Portal Mentor sees own</field>
        <field name="model_id" ref="moo_olympiad.model_moo_olympiad_project"/>
        <field name="domain_force">[('mentor_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>V

    <!-- Portal users should only see students of projects they mentor -->
    <record id="rule_moo_olympiad_student_portal_own" model="ir.rule">
        <field name="name">Student: Portal Mentor sees students of own projects</field>
        <field name="model_id" ref="moo_olympiad.model_moo_olympiad_student"/>
        <field name="domain_force">[('project_student_ids.project_id.mentor_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Portal users only see open or finished events -->
    <record id="rule_moo_olympiad_event_portal_visible" model="ir.rule">
        <field name="name">Event: Portal sees open/finished</field>
        <field name="model_id" ref="moo_olympiad.model_moo_olympiad_event"/>
        <field name="domain_force">[('state', 'in', ['open', 'finished'])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Portal users only see active categories -->
    <record id="rule_moo_olympiad_category_portal_visible" model="ir.rule">
        <field name="name">Category: Portal sees active</field>
        <field name="model_id" ref="moo_olympiad.model_moo_olympiad_category"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Portal users can only see their own jury assignments -->
    <record id="rule_moo_olympiad_jury_assignment_own" model="ir.rule">
        <field name="name">Jury Assignment: Portal Jury sees own</field>
        <field name="model_id" ref="moo_olympiad.model_moo_olympiad_jury_assignment"/>
        <field name="domain_force">[('jury_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    </data>
</odoo>